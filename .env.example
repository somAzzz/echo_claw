# Voice Assistant Hub - Environment Variables
# Copy to .env and customize for your setup

# LLM Configuration
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=unsloth/gemma-4-E4B-it-GGUF:Q8_0
LLM_MAX_TOKENS=131072
LLM_TEMPERATURE=0.7

# ASR Configuration
ASR_BASE_URL=http://localhost:8001
ASR_MODEL=paraformer-zh
ASR_SAMPLE_RATE=16000

# TTS Configuration
TTS_VOICE=zh-CN-YunxiaNeural
TTS_RATE=-20%
TTS_PITCH=+13Hz
TTS_VOLUME=+0%

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
SERVER_HTTP_PORT=8766

# Memory Configuration
MEMORY_SUMMARY_DIR=./memory/summaries
MEMORY_GLOBAL_DIR=./memory/global
MEMORY_GLOBAL_TOP_K=3
MEMORY_GLOBAL_MAX_CHARS=2000

# Debug
DEBUG_OUTPUT_DIR=/tmp/voice-assistant-debug
